# Copy to .env and fill in a random value:
#   openssl rand -hex 24
PANCAKE_WEBHOOK_SECRET=

# Optional -- only needed if pointing consumer at an external ClickHouse
# (e.g. Zeabur) instead of the local docker-compose one. Leave unset to
# use local defaults (host=clickhouse, port=9000, no auth).
# CLICKHOUSE_HOST=
# CLICKHOUSE_PORT=
# CLICKHOUSE_USER=
# CLICKHOUSE_PASSWORD=
